# Copy to `.env` and fill in real values before `vikunja-up.bat`.
# Browser URL. Include the port or signup may return unauthorized.
VIKUNJA_SERVICE_PUBLICURL=http://localhost:3456

# Docker image tag (e.g. latest / v2.7.1 / 2.7.1)
VIKUNJA_IMAGE_TAG=latest

# Secret used for sessions etc. Generate with:
#   openssl rand -base64 48
VIKUNJA_SERVICE_SECRET=change-me-to-a-long-random-string

# PostgreSQL password shared by Vikunja and the db service. Generate with:
#   openssl rand -base64 32
VIKUNJA_DATABASE_PASSWORD=change-me-to-a-strong-password
